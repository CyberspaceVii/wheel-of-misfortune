# Renders what api.php queues: uploaded sounds (ffmpeg → 10 s mp3) and slot names (Piper).
# Started by wom-worker.path, drains the queue, exits. No network, writes only @DATA@.
[Unit]
Description=Wheel of Misfortune: render sounds and voice lines

[Service]
Type=oneshot
User=wom
Group=wom
UMask=0027
Environment=WOM_DATA=@DATA@ WOM_PIPER=@PIPER@
ExecStart=@LIB@/worker.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
MemoryMax=700M
ProtectSystem=strict
ReadWritePaths=@DATA@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
